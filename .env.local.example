# ===== АВТОРИЗАЦИЯ =====
# Секрет для подписи сессий (любая случайная строка ≥32 символов)
AUTH_SECRET=замените_на_случайную_строку_не_менее_32_символов

# Ключ администратора (создайте сложный пароль)
ADMIN_ACCESS_KEY=замените_на_сложный_ключ_администратора

# Wildberries-тег по умолчанию для администратора (название ярлыка в WB)
SELLER_LABEL=Кирилл

# ===== UPSTASH REDIS (продакшн — для хранения менеджеров) =====
# Получить на https://upstash.com — бесплатный тир достаточен
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ===== GROQ =====
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== FAL.AI (генерация базы инфографики) =====
# Ключ с https://fal.ai/dashboard/keys (формат: key_id:key_secret)
FAL_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель генерации базы (по умолчанию flux-pro/kontext ≈ $0.04/изображение).
# НЕ используйте fal-ai/flux-pro/kontext/max (≈ $0.08) — слишком дорого для постоянной генерации.
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext
# (необязательно) Соотношение сторон базы. По умолчанию 3:4 (под карточку WB 900×1200).
# Значение auto/none = сохранить композицию исходного фото. Допустимо: 21:9 16:9 4:3 3:2 1:1 2:3 3:4 9:16 9:21
# FAL_ASPECT_RATIO=3:4

# ===== WILDBERRIES SELLER API =====
# Получить в личном кабинете WB: https://seller.wildberries.ru/supplier-settings/access-to-api
WB_API_TOKEN=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== GOOGLE SHEETS =====
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Сервисный аккаунт Google (JSON одной строкой или путь к файлу)
# Вариант 1: JSON одной строкой (для деплоя)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"wb-analyzer@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Вариант 2: путь к файлу (для локальной разработки)
# GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# ===== MPSTATS =====
# API ключ mpstats.io
MPSTATS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== НАСТРОЙКИ ЛИСТОВ =====
# Названия листов (по умолчанию ниже)
SHEET_UNIT=Unit
SHEET_CHECKLIST=Чек-лист

# Колонка артикула в листе Unit (0 = A, 1 = B, ...)
UNIT_ARTICLE_COL=0

# Колонка с артикулом в листе Чек-лист (0 = A, ... 5 = F)
CHECKLIST_ARTICLE_COL=5

# Колонка с датой в листе Чек-лист (0 = A, 1 = B, ...)
CHECKLIST_DATE_COL=0
